# Copy to .env (run `make env`, which also generates a random SESSION_SECRET_KEY for you).
# NEVER commit the real .env file.

APP_ENV=development            # development | test | production
APP_NAME=ShipTrack

# Local development database (started by `make db`). Docker Compose overrides the host to "db".
DATABASE_URL=postgresql+psycopg://shiptrack:shiptrack@localhost:5432/shiptrack

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# REQUIRED. At least 32 random characters in production. Generate one with: make secret
SESSION_SECRET_KEY=replace-with-a-secure-random-value
SESSION_TTL_HOURS=168
# COOKIE_SECURE defaults to true in production and false otherwise.
# COOKIE_SAMESITE=lax          # use "none" only if the API is on a different site than the frontend

# --- AI bug report assistant -------------------------------------------------
# mock (default, offline, free) | anthropic | openai
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL=                 # optional override for gateways / OpenAI-compatible servers
AI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_CHARS=5000

# --- Hardening ---------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Set to true ONLY when running behind a reverse proxy you control (nginx, a PaaS router).
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=1000000
